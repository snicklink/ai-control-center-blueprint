{
  "name": "@ai-blueprint/react-components",
  "version": "1.0.0",
  "description": "Professional React components for AI cost tracking and model management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify",
